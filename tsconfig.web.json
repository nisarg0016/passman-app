{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["vite.config.ts", "src/main/**/*", "src/preload/**/*","src/renderer/**/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "jsx": "react",
    "paths": {
      "@/*": ["src/renderer/src/*"]
    },
    "moduleResolution": "node"
  }
}