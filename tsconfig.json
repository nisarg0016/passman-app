{
  "include": ["vite.config.ts", "src/main/**/*", "src/preload/**/*","src/renderer/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  "compilerOptions": {
    "jsx": "react",
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["dom", "ESNext"],
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"]
    },
    "moduleResolution": "node"
  }
}